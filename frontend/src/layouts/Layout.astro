---
interface Props {
	title: string;
}

const { title } = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="JuntosDeNovo - Registro e busca de pessoas desaparecidas em cenários de enchente." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | JuntosDeNovo</title>
	</head>
	<body class="bg-gray-100 text-gray-900 min-h-screen flex flex-col font-sans">
		
		<header class="bg-blue-700 text-white p-4 shadow-md">
			<div class="max-w-3xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
				<a href="/" class="text-2xl font-bold flex items-center gap-2 hover:opacity-80 transition">
					<span>🤝</span> JuntosDeNovo
				</a>
				<nav>
					<a href="/cadastro" class="bg-white text-blue-700 px-5 py-2 rounded-lg font-bold shadow hover:bg-gray-100 transition-colors">
						+ Reportar Desaparecimento
					</a>
				</nav>
			</div>
		</header>

		<main class="flex-grow max-w-3xl mx-auto w-full p-4 sm:p-6 mt-4">
			<slot />
		</main>

		<footer class="bg-gray-800 text-gray-400 text-center p-6 mt-auto">
			<p class="text-sm">
				Desenvolvido para o desafio Empower 5.0. <br/>
				Organizando informações para acelerar reencontros.
			</p>
		</footer>

	</body>
</html>

<style is:global>
	html {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		background-color: #f3f4f6; /* gray-100 */
	}
	body {
		margin: 0;
	}
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #f1f1f1; 
	}
	::-webkit-scrollbar-thumb {
		background: #888; 
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #555; 
	}
</style>